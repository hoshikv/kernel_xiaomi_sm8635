# Charger
CONFIG_MI_DTPT=y
CONFIG_MI_ENABLE_DP=y

# Debug
CONFIG_MI_DUMP_DISPLAY=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_QCOM_DYN_MINIDUMP_STACK=y
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_XLOGCHAR=m

# Fingerprint
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_INPUT_FINGERPRINT=y

# HWID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DEVICES=y

# Joystick
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Regulators
CONFIG_REGULATOR_WL2866D=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Vibrator
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set
CONFIG_INPUT_AW86927_HAPTIC=m
CONFIG_SIH_VIBRATOR=m

# Boeffla
CONFIG_BOEFFLA_WL_BLOCKER=y

# Power / no-drain
# Route unbound workqueues to the power-efficient pool and keep the
# console quiet by default to cut idle log/noise wakeups.
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=3

# ZRAM
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_ZRAM_DEF_COMP_ZSTD is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZO is not set
CONFIG_ZRAM_DEF_COMP="lz4"

# Scheduler & I/O
CONFIG_SCHED_BORE=y
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y

# Memory / DAMON / ZRAM
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y
CONFIG_ZRAM_WRITEBACK=y

# Network
CONFIG_NET_SCH_CAKE=y

# Kprofiles & Performance
CONFIG_KPROFILES=y
CONFIG_KP_DEFAULT_MODE=2
